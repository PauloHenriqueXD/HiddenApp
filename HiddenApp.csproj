<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Exige rodar como Administrador (necessário para mexer no Firewall do Windows) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- Ícone do .exe (Explorer / barra de tarefas) -->
    <ApplicationIcon>Assets\HiddenApp.ico</ApplicationIcon>
    <Version>2.3.0</Version>
    <AssemblyTitle>HiddenApp</AssemblyTitle>
    <Product>HiddenApp</Product>
    <Company>Paulo Henrique Ferrari Mantuaneli</Company>
    <Authors>Paulo Henrique Ferrari Mantuaneli</Authors>
    <Copyright>Copyright © 2026 Paulo Henrique Ferrari Mantuaneli (MIT)</Copyright>
    <Description>HiddenApp — bloqueia a internet de programas pelo Firewall do Windows e automatiza cliques</Description>
    <RepositoryUrl>https://github.com/PauloHenriqueXD/HiddenApp</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gera o QR code do Pix (licença MIT, sem dependências) -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ícone e logo embutidos no .exe (janela, bandeja e cabeçalho) -->
    <EmbeddedResource Include="Assets\HiddenApp.ico" LogicalName="HiddenApp.ico" />
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="Lang\en.json" LogicalName="lang.en.json" />
    <EmbeddedResource Include="Lang\zh-CN.json" LogicalName="lang.zh-CN.json" />
  </ItemGroup>

</Project>
