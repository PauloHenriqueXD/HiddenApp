<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publicação "Portátil": gera UM único HiddenApp.exe que já inclui o .NET.
  Roda em qualquer Windows 10/11 64 bits sem instalar nada.
  Visual Studio: botão direito no projeto > Publicar > Portatil > Publicar
  Linha de comando: dotnet publish -p:PublishProfile=Portatil
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>
</Project>
